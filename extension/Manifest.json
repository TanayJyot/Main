{
  "manifest_version": 3,
  "name": "ASLytics",
  "version": "1.0",
  "description": "YouTube ASL Accessibility Tool",

  "permissions": ["activeTab", "scripting"],

  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "*://*.youtube.com/*"
  ],

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ]
}
